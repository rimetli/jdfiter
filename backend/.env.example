APP_ENV=development
APP_NAME=AI Resume Screening
APP_SECRET=replace-with-at-least-32-random-characters
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

MYSQL_HOST=db.example.com
MYSQL_PORT=3306
MYSQL_DATABASE=resume_screening
MYSQL_USERNAME=resume_app
MYSQL_PASSWORD=replace-me
MYSQL_SSL=false
MYSQL_SSL_CA=

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=resumes
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
LOCAL_STORAGE_PATH=storage

LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 默认值为 0.1；若模型网关提示“only 1 is allowed”，设置为 1。
LLM_TEMPERATURE=0.1
# JD 分析的响应长度和超时时间。通常无需调整；JD 特别复杂时可适度上调。
JD_LLM_MAX_TOKENS=1200
JD_LLM_TIMEOUT_SECONDS=55
RESUME_LLM_ENABLED=false
# 扫描版 / 图片型 PDF 的视觉识别。留空时复用 LLM_MODEL。
RESUME_VISION_ENABLED=true
RESUME_VISION_MODEL=
RESUME_VISION_MAX_PAGES=5
RESUME_VISION_DPI=160

# Worker 任务租约、自动重试与指数退避。
TASK_MAX_ATTEMPTS=3
TASK_LEASE_SECONDS=300
TASK_HEARTBEAT_SECONDS=30
TASK_RETRY_BASE_SECONDS=15
TASK_RETRY_MAX_SECONDS=300

# 历史简历回填（先预演，再加 --apply 写入）：
# python -m app.scripts.backfill_candidate_identity
# python -m app.scripts.backfill_candidate_identity --apply
